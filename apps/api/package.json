    "db:migrate:app": "node scripts/migrate.js --target=app",
    "db:seed:reference:test": "node scripts/seed-reference.js --target=test",
    "db:seed:reference:app": "node scripts/seed-reference.js --target=app",
    "db:seed:demo:test": "node scripts/seed-demo.js --target=test",
