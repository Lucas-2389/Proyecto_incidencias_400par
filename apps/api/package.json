{
  "name": "@incidencias/api",
  "version": "0.1.0",
  "private": true,
  "description": "API técnica de la plataforma de gestión de incidencias",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test --test-concurrency=2",
    "contract:check": "node scripts/check-openapi.js",
    "db:check": "node scripts/check-db-connection.js",
    "db:migrate:test": "node scripts/migrate.js --target=test",
    "db:migrate:app": "node scripts/migrate.js --target=app",
    "db:seed:reference:test": "node scripts/seed-reference.js --target=test",
    "db:seed:reference:app": "node scripts/seed-reference.js --target=app",
    "db:seed:demo:test": "node scripts/seed-demo.js --target=test",
    "db:seed:demo:app": "node scripts/seed-demo.js --target=app",
    "territory:preview:test": "node scripts/load-metropolitan-territory.js --target=test",
    "territory:load:test": "node scripts/load-metropolitan-territory.js --target=test --apply",
    "territory:preview:app": "node scripts/load-metropolitan-territory.js --target=app",
    "territory:load:app": "node scripts/load-metropolitan-territory.js --target=app --apply"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.11.0",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "firebase-admin": "^14.5.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "mysql2": "^3.24.5",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "yaml": "^2.9.1"
  },
  "overrides": {
    "gaxios": {
      "uuid": "^11.1.1"
    }
  }
}
