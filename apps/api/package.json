    "firebase-admin": "^14.5.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "mysql2": "^3.24.5",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "yaml": "^2.9.1"
