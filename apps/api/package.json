{
  "name": "@incidencias/api",
  "version": "0.1.0",
  "private": true,
  "description": "API técnica de la plataforma de gestión de incidencias",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test",
    "contract:check": "node scripts/check-openapi.js",
