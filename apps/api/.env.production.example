# Plantilla: configurar estos valores en el gestor de secretos del servidor.
# Nunca desplegar este archivo como configuración con valores de ejemplo.
APP_ENV=production
NODE_ENV=production
PORT=3000
DB_HOST=mysql-service.example.invalid
DB_PORT=12345
DB_NAME=incidencias
DB_USER=incidencias_app
DB_PASSWORD=
DB_SSL=true
DB_CA_PATH=/etc/secrets/ca.pem
JWT_SECRET=
CORS_ORIGINS=https://admin.example.com
PUBLIC_API_URL=https://api.example.com/api/v1
UPLOAD_CONFIGURATION=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# DEV_MAILBOX_DIR se omite: el buzón de archivos es solo para desarrollo.
