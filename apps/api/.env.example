# Copiar como apps/api/.env y usar la contraseña real de incidencias_app.
# El backend no carga el .env de Docker Compose ni usa MYSQL_ROOT_PASSWORD.
PORT=3000
APP_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=incidencias
DB_USER=incidencias_app
DB_PASSWORD=change-me-local-app

# Base aislada para pruebas integradas; nunca usar DB_NAME aquí.
DB_TEST_NAME=incidencias_test

# Generar un secreto local aleatorio de al menos 32 caracteres; no reutilizar este texto.
JWT_SECRET=change-me-with-a-random-local-secret-at-least-32-characters
DEV_MAILBOX_DIR=.local/mailbox
EVIDENCE_DIR=.local/evidence
UPLOAD_CONFIGURATION=local
# Definir ambos para API pública y panel en otro origen.
# CORS_ORIGINS=https://admin.example.com
# PUBLIC_API_URL=https://api.example.com/api/v1
# Opcional: habilita FCM con credenciales ADC fuera del repositorio.
# FCM_PROJECT_ID=
