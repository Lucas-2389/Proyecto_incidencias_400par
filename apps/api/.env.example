# Copiar como apps/api/.env y usar la contraseña real de incidencias_app.
# El backend no carga el .env de Docker Compose ni usa MYSQL_ROOT_PASSWORD.
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=incidencias
DB_USER=incidencias_app
DB_PASSWORD=change-me-local-app

# Base aislada para pruebas integradas; nunca usar DB_NAME aquí.
DB_TEST_NAME=incidencias_test
